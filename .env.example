# Configuration locale : copier en .env et adapter si besoin. Toutes les
# valeurs ci-dessous sont les valeurs par défaut de dev ; .env est lu par le
# Makefile et par docker compose, et n'est jamais commité.

# --- PostgreSQL ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=transactions
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pipeline:pipeline@localhost:5432/transactions

# --- Stockage S3 local (RustFS) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=pipeline
S3_SECRET_KEY=pipelinesecret
S3_BUCKET=transactions
S3_PREFIX=incoming/
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Timeouts d'un appel S3, en secondes
S3_CONNECT_TIMEOUT=2
S3_READ_TIMEOUT=5

# --- Pipeline ---
# Zone de dépôt locale des générateurs (avant upload S3)
INCOMING_DIR=data/incoming
N_FILES=3

# --- Retries (backoff exponentiel x2) ---
S3_MAX_ATTEMPTS=4
S3_RETRY_DELAY=1
